# ── Gemini ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
CHROMA_PERSIST_DIR=./data/chroma

# ── App ───────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
SECRET_KEY=change_me_in_production_use_32_chars_min

# ── Resume ────────────────────────────────────────────────────────────────
RESUME_UPLOAD_DIR=./uploads/resumes
DEFAULT_RESUME_PATH=./uploads/resumes/base_resume.pdf

# ── Job Sources ───────────────────────────────────────────────────────────
LINKEDIN_EMAIL=your_linkedin_email
LINKEDIN_PASSWORD=your_linkedin_password
NAUKRI_EMAIL=your_naukri_email
NAUKRI_PASSWORD=your_naukri_password
INDEED_EMAIL=your_indeed_email
INDEED_PASSWORD=your_indeed_password

# ── Auto-Apply Settings ───────────────────────────────────────────────────
AUTO_APPLY_THRESHOLD=85
MAX_APPLICATIONS_PER_DAY=20
APPLY_DELAY_SECONDS=5

# ── User Profile (pre-fill form fields) ──────────────────────────────────
USER_FULL_NAME=Your Full Name
USER_EMAIL=your@email.com
USER_PHONE=+1234567890
USER_LOCATION=City, State, Country
USER_YEARS_EXPERIENCE=5
USER_CURRENT_SALARY=
USER_EXPECTED_SALARY_INTERN=25k/month
USER_EXPECTED_SALARY_FTE=7 LPA+
USER_NOTICE_PERIOD=Immediate
USER_LINKEDIN_URL=https://linkedin.com/in/yourprofile
USER_GITHUB_URL=https://github.com/raghava4272
USER_PORTFOLIO_URL=
USER_LEETCODE_URL=

# ── CORS / Frontend ───────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
